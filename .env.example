# Jay's Food Court - Environment Configuration
# Copy this file to .env.local and fill in your Supabase project credentials.

# Public Supabase credentials (accessible in browser and server)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Service Role Key (NEVER expose to browser / client-side)
SUPABASE_SERVICE_ROLE_KEY=

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
